# Shell scripts are rsynced verbatim into Linux guests: a lone \r breaks every command.
*.sh   text eol=lf
*.bash text eol=lf
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Read inside Linux guests too (runner catalog, machine catalog, Vagrantfile).
*.conf      text eol=lf
*.json      text eol=lf
Vagrantfile text eol=lf
