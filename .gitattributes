# Shell scripts are rsynced verbatim into Linux guests: a lone \r breaks every command.
*.sh   text eol=lf
*.bash text eol=lf
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Read inside Linux guests too (runner catalog, machine catalog, Vagrantfile).
*.conf      text eol=lf
*.json      text eol=lf
Vagrantfile text eol=lf

# Verdict fixtures for `python rig.py check`, read by the bash runner on Windows too.
*.ndjson             text eol=lf
tests/judge/*/verdict text eol=lf

# Lab agent.toml goldens for tests/lab-agent.ps1: CRLF, as the PowerShell here-string writes them.
tests/lab-agent/*.toml text eol=crlf
