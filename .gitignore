# Vagrant's per-checkout machine state (VM ids, generated SSH keys): never committed.
.vagrant/
.DS_Store
# Offline build bundles (tools/offline_bundle.py).
/.offline/
# Scenario run reports (runner/run-scenarios.sh, fetched by `python rig.py run`): local by default.
# Keep one as evidence with `git add -f reports/<file>` and cite it from docs/machine-matrix.md.
/reports/*
!/reports/README.md
# Bytecode of rig.py's imports (tools/riglib.py).
__pycache__/
