# Multi-VM Vagrant lab — implements the machine matrix from ../MATRIX.md.
#
# macOS Apple Silicon host (QEMU/HVF provider): only the arm64 Linux machines
# run here. The Windows machines (amd64 boxes, VirtualBox/Hyper-V/libvirt)
# are defined for an x86 lab machine — see README.md.
#
#   vagrant up                    # primary machine (ubuntu2404) only
#   vagrant up debian13           # one machine from the matrix
#   vagrant ssh debian13
#   vagrant destroy -f debian13   # rollback = destroy + up (no QEMU snapshots)

# Linux machines: name => [box, local SSH port (the QEMU plugin can't
# auto-allocate, each machine needs a unique host port), RAM].
LINUX_MACHINES = {
  "ubuntu2404" => { box: "perk/ubuntu-24.04-arm64", ssh_port: 50022, primary: true },
  "ubuntu2204" => { box: "perk/ubuntu-2204-arm64",  ssh_port: 50122, libvirt_box: "generic/ubuntu2204" },
  "debian12"   => { box: "cloud-image/debian-12",   ssh_port: 50222, libvirt_box: "generic/debian12" },
  "debian13"   => { box: "cloud-image/debian-13",   ssh_port: 50322 },
  "fedora41"   => { box: "fedora/41-cloud-base",    ssh_port: 50422 },
  "rocky9"     => { box: "rockylinux/9",            ssh_port: 50522, libvirt_box: "generic/rocky9" },
}.freeze

# Windows machines (amd64 — unusable under QEMU arm64, see README.md).
WINDOWS_MACHINES = {
  "win11"     => { box: "gusztavvargadr/windows-11" },
  "win10"     => { box: "gusztavvargadr/windows-10" },
  "winserver" => { box: "gusztavvargadr/windows-server" },
}.freeze

# musl/BusyBox row (amd64, issue #123) — unusable under QEMU arm64 same as the
# Windows machines above, and `../vagrant-hyperv` is Hyper-V-only, so this runs
# under VirtualBox on an x86 lab host instead. `generic/alpine319` is the newest
# version Vagrant Cloud publishes with a virtualbox/amd64 provider (3.19.x, not
# the 3.24 MATRIX.md/#123 was manually validated against) — close enough for
# musl/BusyBox toolchain coverage, not a kernel-version-sensitive row.
ALPINE_VIRTUALBOX_MACHINES = {
  "alpine319" => { box: "generic/alpine319" },
}.freeze

Vagrant.configure("2") do |config|
  # The QEMU and libvirt providers get no native file sharing here: the umbrella is
  # pushed via rsync to /synthaea at `vagrant up` (push again afterwards
  # with `vagrant rsync <machine>`). Build artifacts stay inside the VM.
  # "../.." is the umbrella checkout (lab/<vagrant dir> -> lab -> umbrella).
  config.vm.synced_folder "../..", "/synthaea", type: "rsync",
    rsync__exclude: [".git/", "target/", "node_modules/", ".next/", "ml/.venv/", "ml/datasets/"]

  LINUX_MACHINES.each do |name, opts|
    config.vm.define name, primary: opts[:primary], autostart: !!opts[:primary] do |m|
      m.vm.box = opts[:box]
      m.vm.hostname = "synthaea-#{name}"

      # Linux hosts with KVM: vagrant-libvirt, on the x86_64 `generic/*` box where one
      # exists (the default boxes above are arm64 builds for the QEMU/HVF harness).
      m.vm.provider "libvirt" do |lv, override|
        override.vm.box = opts[:libvirt_box] if opts[:libvirt_box]
        lv.memory = 6144
        lv.cpus = 4
      end

      m.vm.provider "qemu" do |qe|
        qe.memory = "4G"
        qe.smp = "4"
        qe.ssh_port = opts[:ssh_port]
        # Plugin defaults already correct on Apple Silicon: arch aarch64,
        # machine virt + highmem, cpu host, HVF acceleration,
        # qemu_dir /opt/homebrew/share/qemu.
      end

      # Provisioning is provider-neutral and shared by every harness.
      m.vm.provision "shell", path: "../../agent/toolchain/linux-toolchain.sh", privileged: false
    end
  end

  WINDOWS_MACHINES.each do |name, opts|
    config.vm.define name, autostart: false do |m|
      m.vm.box = opts[:box]
      m.vm.communicator = "winrm"

      ["virtualbox", "hyperv", "vmware_desktop"].each do |p|
        m.vm.provider p do |v|
          v.memory = 8192 if v.respond_to?(:memory=)
          v.cpus = 4 if v.respond_to?(:cpus=)
        end
      end

      # Provider-neutral, same as the Linux machines above (#22): rustup +
      # the MSVC/Windows SDK Build Tools the ETW/Event Log/SCM sensors need.
      # `agent-install.ps1` (also in ../provisioning/) is run separately, per
      # scenario, once a build exists — not part of one-time provisioning.
      m.vm.provision "shell", path: "../../agent/toolchain/windows-toolchain.ps1"
    end
  end

  ALPINE_VIRTUALBOX_MACHINES.each do |name, opts|
    config.vm.define name, autostart: false do |m|
      m.vm.box = opts[:box]
      m.vm.hostname = "synthaea-#{name}"

      m.vm.provider "virtualbox" do |vb|
        vb.memory = 4096
        vb.cpus = 4
      end

      m.vm.provision "shell", path: "../../agent/toolchain/alpine-toolchain.sh", privileged: false
    end
  end
end
